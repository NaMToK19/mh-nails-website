---
import { Icon } from 'astro-icon/components';
---
<section id="kontakt" class="py-20 bg-black text-stone-300 px-4">
  <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12">
    <div>
      <h2 class="text-3xl font-serif text-white mb-8">Kontakt & Anfahrt</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
        <div>
          <h3 class="text-lg font-bold text-white mb-2">MH Nails</h3>
          <p class="mb-1">Schillerstraße 15</p>
          <p class="mb-4">76135 Karlsruhe</p>
          <p class="mb-1">📞 0123 / 456 789</p>
          <p>✉️ info@mh-nails.de</p>
        </div>
        
        <div>
          <h3 class="text-lg font-bold text-white mb-2">Anreise mit der Bahn</h3>
          <p class="mb-1"><strong>Haltestellen:</strong></p>
          <ul class="list-disc list-inside mb-1 text-stone-400">
            <li>Schillerstraße</li>
            <li>Mühlburger Tor</li>
          </ul>
          <p class="mb-4"><strong>Bahnlinien:</strong> 2</p>
          
          <a href="https://www.kvv.de/fahrplan/fahrplanauskunft.html" target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-sm bg-stone-900 hover:bg-[#D4AF37] text-stone-300 hover:text-black px-4 py-2 rounded-lg transition shadow-sm border border-stone-800 hover:border-[#D4AF37]">
            <Icon name="mdi:open-in-new" class="w-4 h-4 mr-2" />
            KVV Fahrplanauskunft
          </a>
        </div>
      </div>
      
      <div>
        <h3 class="text-lg font-bold text-white mb-4">Öffnungszeiten</h3>
        <div class="space-y-2 max-w-sm">
          <div class="flex justify-between border-b border-stone-800 pb-2"><span>Mo, Di, Do, Fr</span><span>09:00 - 18:00 Uhr</span></div>
          <div class="flex justify-between border-b border-stone-800 pb-2 text-[#D4AF37]"><span>Mittwoch</span><span>Geschlossen</span></div>
          <div class="flex justify-between border-b border-stone-800 pb-2"><span>Samstag</span><span>10:00 - 13:00 Uhr</span></div>
          <div class="flex justify-between text-[#D4AF37] pt-1"><span>Sonntag</span><span>Geschlossen</span></div>
        </div>
      </div>
    </div>

    <div class="h-64 lg:h-full min-h-[300px] w-full bg-stone-900 rounded-xl overflow-hidden shadow-lg border border-stone-800">
      <iframe 
        width="100%" 
        height="100%" 
        frameborder="0" 
        scrolling="no" 
        marginheight="0" 
        marginwidth="0" 
        src="https://maps.google.com/maps?q=Schillerstra%C3%9Fe%2015,%2076135%20Karlsruhe&t=&z=15&ie=UTF8&iwloc=&output=embed"
        style="border:0;" 
        allowfullscreen="" 
        loading="lazy" 
        referrerpolicy="no-referrer-when-downgrade">
      </iframe>
    </div>
  </div>
</section>