<section id="preise" class="py-20 px-4 bg-stone-50">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-3xl font-serif text-center text-black mb-12">Preisliste</h2>
    <div class="bg-white rounded-3xl shadow-sm p-8 border border-stone-100">
      <div class="flex justify-between items-center border-b border-stone-100 py-4">
        <span class="font-medium text-stone-800">Klassische Maniküre</span>
        <span class="font-bold text-black">ab 25 €</span>
      </div>
      <div class="flex justify-between items-center border-b border-stone-100 py-4">
        <span class="font-medium text-stone-800">Maniküre mit Shellac</span>
        <span class="font-bold text-black">35 €</span>
      </div>
      <div class="flex justify-between items-center border-b border-stone-100 py-4">
        <span class="font-medium text-stone-800">Neumodellage (UV-Gel)</span>
        <span class="font-bold text-black">55 €</span>
      </div>
      <div class="flex justify-between items-center py-4">
        <span class="font-medium text-stone-800">Auffüllen (UV-Gel)</span>
        <span class="font-bold text-black">40 €</span>
      </div>
      
      <div class="mt-6 pt-6 border-t border-dashed border-stone-200 text-center text-sm text-stone-500">
        Preise für Wimpernverlängerung und Kosmetik auf Anfrage.
      </div>
    </div>
  </div>
</section>