---
---
<section id="termin" class="py-20 px-4 bg-stone-100">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-10">
      <h2 class="text-3xl font-serif text-black mb-4">Termin buchen</h2>
      <p class="text-stone-600">Fülle das Formular aus, um deinen Wunschtermin bei uns anzufragen.</p>
    </div>

    <form class="bg-white rounded-3xl shadow-sm p-8 space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label for="name" class="block text-sm font-medium text-stone-700 mb-1">Name</label>
          <input type="text" id="name" name="name" required class="w-full border border-stone-300 rounded-lg px-4 py-2 focus:ring-[#D4AF37] focus:border-[#D4AF37] outline-none transition" placeholder="Dein Name" />
        </div>
        <div>
          <label for="phone" class="block text-sm font-medium text-stone-700 mb-1">Telefonnummer</label>
          <input type="tel" id="phone" name="phone" required class="w-full border border-stone-300 rounded-lg px-4 py-2 focus:ring-[#D4AF37] focus:border-[#D4AF37] outline-none transition" placeholder="Für Rückfragen" />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label for="service" class="block text-sm font-medium text-stone-700 mb-1">Gewünschte Leistung</label>
          <select id="service" name="service" class="w-full border border-stone-300 rounded-lg px-4 py-2 focus:ring-[#D4AF37] focus:border-[#D4AF37] outline-none transition bg-white">
            <option>Maniküre & Nageldesign</option>
            <option>Pediküre</option>
            <option>Wimpernverlängerung</option>
            <option>Kosmetik & Tiefenreinigung</option>
          </select>
        </div>
        <div>
          <label for="date" class="block text-sm font-medium text-stone-700 mb-1">Wunschdatum</label>
          <input type="date" id="date" name="date" class="w-full border border-stone-300 rounded-lg px-4 py-2 focus:ring-[#D4AF37] focus:border-[#D4AF37] outline-none transition" />
        </div>
      </div>

      <div>
        <label for="message" class="block text-sm font-medium text-stone-700 mb-1">Nachricht (optional)</label>
        <textarea id="message" name="message" rows="4" class="w-full border border-stone-300 rounded-lg px-4 py-2 focus:ring-[#D4AF37] focus:border-[#D4AF37] outline-none transition" placeholder="Besondere Wünsche oder Fragen?"></textarea>
      </div>

      <button type="submit" class="w-full bg-black hover:bg-[#D4AF37] text-white font-bold py-3 px-4 rounded-lg transition shadow-md">
        Termin anfragen
      </button>
    </form>
  </div>
</section>